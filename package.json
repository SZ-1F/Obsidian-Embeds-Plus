{
	"name": "Embeds+",
	"version": "1.1.3",
	"description": "View and embed HTML, MHTML, and Web Archive files natively with full styling and inline preview support.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:local": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production; bash Deploy.sh",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"html",
		"viewer",
		"embed",
		"mhtml",
		"webarchive"
	],
	"author": "@SZ-1F",
	"license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "25.8.0",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.3.0",
    "globals": "17.6.0",
    "jiti": "2.7.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3"
  },
  "dependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@plist/plist": "1.0.0",
    "node-html-parser": "7.1.0",
    "obsidian": "1.12.3"
  },
  "overrides": {
    "fast-xml-parser": "5.8.0"
  }
}
